<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_premium_gradient">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:title="@string/menu_library_label"
        app:titleTextColor="?attr/colorPrimary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/library_latest_releases_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="start|center_vertical"
                android:text="Dernières sorties"
                app:icon="@drawable/ic_history"
                app:iconTint="?attr/colorPrimary"
                android:textSize="18sp"
                app:iconSize="32dp"
                android:textColor="?attr/appTextColorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/library_artists_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="start|center_vertical"
                android:text="@string/library_title_artist"
                app:icon="@drawable/ic_placeholder_artist"
                app:iconTint="?attr/colorPrimary"
                android:textSize="18sp"
                app:iconSize="32dp"
                android:textColor="?attr/appTextColorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/library_albums_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="start|center_vertical"
                android:text="@string/library_title_album"
                app:icon="@drawable/ic_placeholder_album"
                app:iconTint="?attr/colorSecondary"
                android:textSize="18sp"
                app:iconSize="32dp"
                android:textColor="?attr/appTextColorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/library_songs_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="start|center_vertical"
                android:text="@string/library_title_starred_tracks"
                app:icon="@drawable/ic_favorite"
                app:iconTint="@color/success_green"
                android:textSize="18sp"
                app:iconSize="32dp"
                android:textColor="?attr/appTextColorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/library_genres_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="start|center_vertical"
                android:text="@string/library_title_genre"
                app:icon="@drawable/ic_history"
                app:iconTint="@color/warning_orange"
                android:textSize="18sp"
                app:iconSize="32dp"
                android:textColor="?attr/appTextColorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/library_playlists_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="start|center_vertical"
                android:text="@string/library_title_playlist"
                app:icon="@drawable/ic_placeholder_playlist"
                app:iconTint="?attr/colorPrimary"
                android:textSize="18sp"
                app:iconSize="32dp"
                android:textColor="?attr/appTextColorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/library_shared_playlist_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="start|center_vertical"
                android:text="@string/shared_playlist_title"
                android:visibility="gone"
                app:icon="@drawable/ic_placeholder_playlist"
                app:iconTint="?attr/colorSecondary"
                android:textSize="18sp"
                app:iconSize="32dp"
                android:textColor="?attr/appTextColorPrimary" />

            <View style="@style/Divider" android:layout_marginVertical="16dp" android:background="?attr/appTextColorPrimary" android:alpha="0.2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/library_downloads_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="start|center_vertical"
                android:text="@string/download_title_section"
                app:icon="@drawable/ic_download"
                app:iconTint="?attr/colorSecondary"
                android:textSize="18sp"
                app:iconSize="32dp"
                android:textColor="?attr/appTextColorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/library_folders_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="start|center_vertical"
                android:text="Intelligence Artificielle"
                app:icon="@drawable/ic_info_stream"
                app:iconTint="?attr/colorPrimary"
                android:textSize="18sp"
                app:iconSize="32dp"
                android:textColor="?attr/appTextColorPrimary" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
