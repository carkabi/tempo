<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/peach_radio_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/appCardBackground"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:strokeColor="?attr/appCardStroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="96dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/peach_radio_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_radio_premium"
                app:shapeAppearanceOverlay="@style/PeachRadioLogoShape" />

            <TextView
                android:id="@+id/peach_radio_live_badge"
                style="@style/LabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_peach_live_badge"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp"
                android:text="ON AIR"
                android:textColor="#161018"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>

        <TextView
            android:id="@+id/peach_radio_name"
            style="@style/TitleMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="?attr/appTextColorPrimary"
            android:textStyle="bold"
            tools:text="Peach Hits" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
