<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_premium_gradient">

    <TextView
        style="@style/TitleLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Assistant IA Peach"
        android:textColor="@color/accent_gold"
        android:textStyle="bold" />

    <TextView
        style="@style/TitleMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Quel genre de musique préférez-vous aujourd'hui ?"
        android:textColor="@color/white" />

    <Spinner
        android:id="@+id/ai_genre_spinner"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="#33FFFFFF"
        android:theme="@style/ThemeOverlay.AppCompat.Dark" />

    <TextView
        style="@style/TitleMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Une décennie favorite ?"
        android:textColor="@color/white" />

    <Spinner
        android:id="@+id/ai_decade_spinner"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="#33FFFFFF"
        android:theme="@style/ThemeOverlay.AppCompat.Dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/ai_cancel_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Annuler"
            android:textColor="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ai_generate_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Générer ma playlist"
            app:backgroundTint="@color/accent_gold"
            android:textColor="@color/peach_background" />
    </LinearLayout>
</LinearLayout>